generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CASHIER
  CUSTOMER
}

enum CodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DINE_IN
  DELIVERY
}

enum PaymentMethod {
  CASH
  INSTAPAY
  VODAFONE_CASH
}

enum PaymentNumberType {
  INSTAPAY
  VODAFONE_CASH
}



enum PaymentStatus {
  PENDING
  CONFIRMED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  role          Role     @default(CUSTOMER)
  active        Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders    Order[]
  auditLogs AuditLog[]
  favoriteProducts FavoriteProduct[]
  @@index([email])
  @@index([role])
  @@map("users")
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      CodeType
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@map("verification_codes")
}


model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  imageUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  @@index([active])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  basePrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productFlavors ProductFlavor[]
  orderItems     OrderItem[]
  favoriteProducts FavoriteProduct[]
  
  @@index([categoryId])
  @@index([active])
  @@map("products")
}

model Flavor {
  id              String   @id @default(uuid())
  name            String   @unique
  additionalPrice Decimal  @default(0) @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  productFlavors   ProductFlavor[]
  orderItemFlavors OrderItemFlavor[]
  @@index([active])
  @@map("flavors")
}

model ProductFlavor {
  id        String @id @default(uuid())
  productId String
  flavorId  String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavor  Flavor  @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  @@unique([productId, flavorId])
  @@index([productId])
  @@index([flavorId])
  @@map("product_flavors")
}


model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  cashierId       String
  orderType       OrderType     @default(DINE_IN)
  deliveryAddress String?
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus   @default(PENDING)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cashier    User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  @@index([cashierId])
  @@index([status])
  @@index([orderType])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItemFlavors OrderItemFlavor[]
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemFlavor {
  id          String @id @default(uuid())
  orderItemId String
  flavorId    String
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  flavor    Flavor    @relation(fields: [flavorId], references: [id], onDelete: Restrict)
  @@unique([orderItemId, flavorId])
  @@index([orderItemId])
  @@map("order_item_flavors")
}


model PaymentNumber {
  id        String            @id @default(uuid())
  type      PaymentNumberType
  number    String
  name      String            // اسم صاحب الرقم
  isDefault Boolean           @default(false)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([type])
  @@index([isDefault])
  @@map("payment_numbers")
}

model StockItem {
  id        String   @id @default(uuid())
  name      String   @unique
  unit      String   @default("piece") // piece, kg, liter, box, bag, etc.
  quantity  Decimal  @default(0) @db.Decimal(10, 2)
  lowStock  Decimal  @default(10) @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantity])
  @@map("stock_items")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model FavoriteProduct {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorite_products")
}
